{
  "name": "flashoverlay",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/pgi/flashoverlay",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:x11": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:main\" \"npm:dev:electron:x11\"",
    "dev:main": "tsc -p tsconfig.electron.json --watch",
    "dev:electron": "wait-on http://127.0.0.1:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --no-sandbox --disable-gpu .",
    "dev:electron:x11": "wait-on http://127.0.0.1:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --no-sandbox --disable-gpu --ozone-platform=x11 .",
    "server": "node dist-electron/server/main.js",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
